# Copia este fichero a `.env` y rellena los valores.
# `.env` está ignorado por git; no subas nunca tus claves reales.

# API key de Steam (opcional). Sin ella el servidor solo usa csstats.gg.
STEAM_API_KEY=

# Puerto del servidor (opcional, por defecto 3000).
PORT=3000

# Orígenes permitidos para CORS, separados por comas (opcional). Admite `*`.
# Por defecto solo se permiten la web de producción y localhost.
CORS_ORIGINS=https://labarcadelaparca.vercel.app,https://*.vercel.app,http://localhost:4200

# Secreto para forzar un refresco manual vía `POST /api/refresh` con
# `Authorization: Bearer <token>` (opcional). Sin él el endpoint queda
# deshabilitado (404). Genéralo, por ejemplo, con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REFRESH_TOKEN=

# Máximo de peticiones a `POST /api/refresh` cada 15 minutos (opcional, por
# defecto 5). Evita el abuso aunque el token se filtre.
REFRESH_RATE_MAX=5
