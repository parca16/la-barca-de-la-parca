# Client ID de Google Cloud (OAuth 2.0)
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# Client secret de Google Cloud
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Emails autorizados separados por comas. Si está vacía, no entra nadie.
AUTH_ALLOWED_EMAILS=parca@example.com,kevs@example.com

# Secreto para firmar la cookie de sesión (32+ bytes aleatorios).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SESSION_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# URL base pública de la app. En local con proxy de Angular: http://localhost:4200
# En producción: https://labarcadelaparca.vercel.app
AUTH_BASE_URL=http://localhost:4200

# Clave (hex, 64 caracteres) para cifrar/descifrar las clases de Contenidos.
# Usa la MISMA en Vercel y en local. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONTENT_CLASSES_KEY=
